# API Configuration
REACT_APP_API_URL=http://localhost:5000
REACT_APP_SOCKET_URL=http://localhost:5001

# Environment
REACT_APP_ENV=development

# Authentication
REACT_APP_ADMIN_EMAIL=admin@gmail.com
REACT_APP_JWT_STORAGE_KEY=fashion_shop_token
REACT_APP_AUTH_PERSIST=true

# Feature Flags
REACT_APP_ENABLE_CHAT=true
REACT_APP_ENABLE_RECOMMENDATIONS=true
REACT_APP_ENABLE_FLASH_SALES=true
REACT_APP_ENABLE_IMAGE_OPTIMIZATION=true
REACT_APP_ENABLE_ANALYTICS=true

# Product Display
REACT_APP_MAX_RELATED_PRODUCTS=4
REACT_APP_MAX_FLASH_SALE_ITEMS=6
REACT_APP_MAX_RECOMMENDATIONS=10
REACT_APP_ITEMS_PER_PAGE=12

# Image Configuration
REACT_APP_DEFAULT_IMAGE_QUALITY=80
REACT_APP_MAX_IMAGE_SIZE=5242880
REACT_APP_IMAGE_FALLBACK=/images/placeholder.png

# Performance
REACT_APP_DEBOUNCE_DELAY=300
REACT_APP_INFINITE_SCROLL_THRESHOLD=800
REACT_APP_CACHE_DURATION=3600

# Analytics
REACT_APP_GA_TRACKING_ID=your_ga_tracking_id

# Chat Configuration
REACT_APP_CHAT_REFRESH_INTERVAL=10000
REACT_APP_MAX_CHAT_HISTORY=50

# Error Reporting
REACT_APP_ERROR_REPORTING_URL=http://localhost:5000/api/errors
REACT_APP_ERROR_REFRESH_RATE=5000

DANGEROUSLY_DISABLE_HOST_CHECK=true